using System;

class Program
{
    static void Main(string[] args)
    {
        int num;
        int max = 0;
        int min = 9999;

        for (int i = 0; i < 5; i++)
        {
            Console.Write("숫자를 입력해주세요: ");
            num = int.Parse(Console.ReadLine());

            if (num > max)
            {
                max = num;
            }

            if (num < min)
            {
                min = num;
            }
        }

        Console.WriteLine("----------------");
        Console.WriteLine("가장 큰 수: " + max);
        Console.WriteLine("가장 작은 수: " + min);
    }
}
